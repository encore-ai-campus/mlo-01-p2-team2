{
  "source": {
    "type": "django_mongodb",
    "database_alias": "mongodb",
    "settings_module": "config.settings",
    "project_root": "../django",
    "database": "legacy_raw",
    "collection": "records",
    "query": {},
    "batch_size": 500
  },
  "quality": {
    "required_fields": [
      "dataset_id",
      "source_record_id",
      "normalization_run_id",
      "employee_id",
      "employee_name",
      "department_name",
      "position_name",
      "hire_datetime",
      "is_active",
      "area_id",
      "area_name",
      "manager_employee_id",
      "area_registered_at",
      "top_area_id",
      "top_area_name",
      "top_area_level",
      "top_area_registered_at",
      "correction_codes"
    ],
    "field_types": {
      "dataset_id": "string",
      "source_record_id": "string",
      "normalization_run_id": "string",
      "employee_id": "string",
      "employee_name": "string",
      "department_name": "string",
      "position_name": "string",
      "hire_datetime": "string",
      "is_active": "boolean",
      "area_id": "string",
      "area_name": "string",
      "manager_employee_id": "string",
      "area_registered_at": "string",
      "top_area_id": "string",
      "top_area_name": "string",
      "top_area_level": "string",
      "top_area_registered_at": "string",
      "correction_codes": "array"
    }
  },
  "standardization": {
    "rules_file": "rules/silver_canonical.yaml"
  },
  "output": {
    "directory": "output"
  },
  "sink": {
    "type": "django_mongodb",
    "database_alias": "mongodb",
    "settings_module": "config.settings",
    "project_root": "../django",
    "success_database": "legacy_standardized",
    "success_collection": "records",
    "failure_database": "legacy_failed",
    "failure_collection": "records",
    "bronze_collection": "bronze_raw_records",
    "manifest_collection": "bronze_manifest",
    "report_database": "legacy_standardized",
    "report_collection": "pipeline_runs",
    "silver_database": "legacy_standardized",
    "silver_collections": {
      "silver_employee": "silver_employee",
      "silver_area": "silver_area",
      "silver_parent_area": "silver_parent_area",
      "silver_top_area_detail": "silver_top_area_detail"
    },
    "batch_size": 500,
    "local_report": true
  },
  "reprocess": {
    "enabled": true,
    "database_alias": "mongodb",
    "settings_module": "config.settings",
    "project_root": "../django",
    "database": "legacy_failed",
    "collection": "records",
    "batch_size": 500,
    "max_attempts": 3,
    "query": {}
  },
  "schedule": {
    "enabled": true,
    "interval_seconds": 180,
    "delay_seconds": 60,
    "watermark_field": "ingested_at",
    "watermark_path": "state/ingest_watermark.json",
    "lock_path": "state/pipeline.lock",
    "run_immediately": true,
    "reprocess_on_tick": true
  },
  "data_lake": {
    "enabled": true,
    "root": "data_lake",
    "interval_minutes": 60,
    "database_alias": "mongodb",
    "settings_module": "config.settings",
    "project_root": "../django",
    "batch_size": 500
  },
  "logging": {
    "level": "INFO",
    "directory": "../django/log_rake"
  }
}
